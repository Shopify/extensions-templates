// @extension-target: pos.payment.validations.resolution.render
import "@shopify/ui-extensions/preact";
import {render} from 'preact';
import {useEffect, useState} from 'preact/hooks';
import {
  CASH_REVIEW_KEY,
  cashReviewFingerprint,
} from './CashReview.{{ srcFileExtension }}';

export default async () => {
  render(<Extension />, document.body);
};

function Extension() {
  const {i18n} = shopify;
  const {paymentMethod, amount} = shopify.resolution.event.value;
  const [error, setError] = useState('');

  useEffect(() => {
    let active = true;
    const registration = shopify.resolution.onSave(async () => {
      if (!active) return;
      setError('');

      try {
        const fingerprint = cashReviewFingerprint(
          shopify.resolution.event.value,
          shopify.cart.current.value,
        );
        await shopify.storage.set(CASH_REVIEW_KEY, {fingerprint});
        shopify.toast.show(i18n.translate('saved'));
      } catch (saveError) {
        if (active) {
          setError('saveFailed');
          shopify.toast.show(i18n.translate('saveFailed'));
        }
        throw saveError;
      }
    });

    void registration.catch(() => {
      if (active) setError('saveUnavailable');
    });

    return () => {
      active = false;
      void registration.then((unregister) => unregister()).catch(console.error);
    };
  }, []);

  return (
    <s-scroll-box padding="base">
      <s-stack direction="block" gap="large">
        <s-heading>{i18n.translate('heading')}</s-heading>
        <s-text>{i18n.translate('instructions')}</s-text>
        <s-text>{i18n.translate('paymentMethod', {method: paymentMethod.type})}</s-text>
        <s-text>{i18n.translate('cashReceived', {
          amount: amount.amount,
          currencyCode: amount.currencyCode,
        })}</s-text>
        {error ? (
          <s-banner tone="critical" heading={i18n.translate(error)} />
        ) : undefined}
      </s-stack>
    </s-scroll-box>
  );
}

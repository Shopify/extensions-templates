api_version = "2026-10"
[[extensions]]
type = "ui_extension"
# Change the merchant-facing name of the extension in locales/en.default.json
name = "t:name"
{% if uid %}uid = "{{ uid }}"{% endif %}
handle = "{{ handle }}"
description = "A blocking cash-payment review example"

[extensions.supported_features]
runs_offline = true

# Keep modules nested: CLI 4.8 appends .jsx to every top-level src file for Preact.
[[extensions.targeting]]
module = "./src/payment_intercept/background.js"
target = "pos.app.ready.data"

[[extensions.targeting.capabilities.intercepts]]
event = "paymentvalidations"
blocking = true
applies_to = ["cash"]

[[extensions.targeting]]
module = "./src/payment_intercept/payment_resolution.jsx"
target = "pos.payment.validations.resolution.render"

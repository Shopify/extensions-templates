import "@shopify/ui-extensions/preact";
import {render} from 'preact';
import {useEffect} from 'preact/hooks';

export default async () => {
  render(<Extension />, document.body);
};

function Extension() {
  const {i18n} = shopify;

  useEffect(() => {
    let active = true;
    const registration = shopify.resolution.onSave(async () => {
      if (!active) return;

      try {
        await shopify.cart.addCartProperties({
          example_cart_reviewed: 'true',
        });
      } catch (error) {
        if (active) shopify.toast.show(i18n.translate('saveFailed'));
        throw error;
      }
    });

    void registration.catch(() => {
      if (active) shopify.toast.show(i18n.translate('saveUnavailable'));
    });

    return () => {
      active = false;
      void registration.then((unregister) => unregister()).catch((error) => {
        console.error('Could not clean up the cart review save handler.', error);
      });
    };
  }, []);

  return <s-text>{i18n.translate('instructions')}</s-text>;
}
